#!/bin/bash
# Opción 3: Acciones sobre el contenido de un archivo tipo agenda
# Formato de cada línea: CI:Nombre:Apellido:Teléfono:FechaNacimiento:Edad
. ./funciones.sh

# Si la agenda no existe, la creamos vacía (así las opciones b-f no fallan)
touch "$ARCHIVO_AGENDA"

while true
do
	clear
	mostrar_encabezado
	echo " Acciones sobre un archivo"
	echo "-----------------------------"
	echo "a) Agregar una persona a la agenda"
	echo "b) Ver la agenda completa"
	echo "c) Ver algunas líneas"
	echo "d) Buscar un dato de una persona por CI"
	echo "e) Eliminar una persona por CI"
	echo "f) Modificar el teléfono de una persona"
	echo "0) Salir"
	mostrar_pie
	read opcion

	case $opcion in
	a)
		read -p "CI: " ci
		read -p "Apellido: " apellido
		read -p "Nombre: " nombre
		read -p "Teléfono: " telefono
		read -p "Fecha de nacimiento (dd/mm/aaaa): " fnac

		# Comprobamos que la fecha tenga el formato dd/mm/aaaa
		if echo "$fnac" | grep -q "^[0-9][0-9]/[0-9][0-9]/[0-9][0-9][0-9][0-9]$"
		then
			# Separamos día, mes y año usando "/" como separador
			dia=$(echo "$fnac" | cut -d/ -f1)
			mes=$(echo "$fnac" | cut -d/ -f2)
			anio=$(echo "$fnac" | cut -d/ -f3)

			# Edad = año actual - año de nacimiento
			edad=$(( $(date +%Y) - anio ))

			# Si todavía no cumplió años este año, le restamos 1.
			# Comparamos "mesdia" como número: hoy (ej. 1014) contra el cumpleaños (ej. 1225)
			if test "$(date +%m%d)" -lt "$mes$dia"
			then
				edad=$(( edad - 1 ))
			fi

			echo "$ci:$nombre:$apellido:$telefono:$fnac:$edad" >> "$ARCHIVO_AGENDA"
			echo "Persona agregada correctamente."
		else
			error_rojo "Fecha inválida. Use el formato dd/mm/aaaa."
		fi
		registrar_log "3a" "agregar CI $ci a $ARCHIVO_AGENDA";;

	b)
		echo "CI | Nombre | Apellido | Teléfono | Fecha nac. | Edad"
		echo "-----------------------------------------------------"
		# Mostramos el archivo cambiando los ":" por " | "
		sed 's/:/ | /g' "$ARCHIVO_AGENDA"
		registrar_log "3b" "listar $ARCHIVO_AGENDA";;

	c)
		read -p "Desde la línea: " desde
		read -p "Hasta la línea: " hasta
		sed -n "${desde},${hasta}p" "$ARCHIVO_AGENDA"
		registrar_log "3c" "sed -n ${desde},${hasta}p $ARCHIVO_AGENDA";;

	d)
		read -p "CI de la persona: " ci
		echo "Campo a mostrar: 1) CI  2) Nombre  3) Apellido  4) Teléfono  5) Fecha nac.  6) Edad"
		read campo

		if grep -q "^$ci:" "$ARCHIVO_AGENDA"
		then
			case $campo in
			[1-6])
				grep "^$ci:" "$ARCHIVO_AGENDA" | cut -d: -f"$campo";;
			*)
				error_rojo "Campo inválido. Debe ser un número del 1 al 6.";;
			esac
		else
			error_rojo "No existe una persona con la CI $ci"
		fi
		registrar_log "3d" "buscar CI $ci campo $campo";;

	e)
		read -p "CI de la persona a eliminar: " ci
		if grep -q "^$ci:" "$ARCHIVO_AGENDA"
		then
			sed -i "/^$ci:/d" "$ARCHIVO_AGENDA"    # borra la línea que empieza con esa CI
			echo "Persona eliminada correctamente."
		else
			error_rojo "No existe una persona con la CI $ci"
		fi
		registrar_log "3e" "eliminar CI $ci";;

	f)
		read -p "CI de la persona: " ci
		if grep -q "^$ci:" "$ARCHIVO_AGENDA"
		then
			read -p "Nuevo teléfono: " telefono

			# Partimos la línea en dos: lo que va antes y después del teléfono
			linea=$(grep "^$ci:" "$ARCHIVO_AGENDA")
			antes=$(echo "$linea" | cut -d: -f1-3)     # CI:Nombre:Apellido
			despues=$(echo "$linea" | cut -d: -f5-6)   # Fecha:Edad

			# Borramos la línea vieja y agregamos la nueva con el teléfono cambiado
			sed -i "/^$ci:/d" "$ARCHIVO_AGENDA"
			echo "$antes:$telefono:$despues" >> "$ARCHIVO_AGENDA"
			echo "Teléfono modificado correctamente."
		else
			error_rojo "No existe una persona con la CI $ci"
		fi
		registrar_log "3f" "modificar teléfono CI $ci";;

	0)
		break;;

	*)
		error_rojo "Opción inválida. Elija una letra de la a a la f, o 0 para salir.";;
	esac

	pausar
done
